{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/after-edit.mjs\"",
            "timeout": 90,
            "statusMessage": "타입·보안 점검 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/before-commit.mjs\"",
            "timeout": 300,
            "statusMessage": "커밋 전 시험 중"
          }
        ]
      }
    ]
  }
}
