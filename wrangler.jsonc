{
  // 둘이자산: 앱 화면과 동기화 서버를 한 Worker에서 내보낸다.
  "name": "duri-budget",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // 공개 주소: https://duri-budget.nestwork.workers.dev. 버전별 미리보기 주소는 열지 않는다.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duri-budget",
      // Cloudflare D1 duri-budget (APAC, 2026-11-03 만듦). 로컬 개발은 .wrangler 안의 복사본을 쓴다.
      "database_id": "12d52e06-9100-4c4a-9567-f117b33e1612",
      "migrations_dir": "migrations"
    }
  ],
  // 매일 오전 9시(한국 시간)에 금리 · 규제 소식을 새로 받는다. ECOS_API_KEY는 `wrangler secret put ECOS_API_KEY`로 넣는다.
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true }
}
